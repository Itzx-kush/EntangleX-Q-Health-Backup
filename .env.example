# Local development defaults. Copy to .env; never commit real credentials.
# Local mode uses SQLite and the repository filesystem.
QHEALTH_STORAGE_BACKEND=local
QHEALTH_STORAGE_ROOT=.
QHEALTH_SERVERLESS=false

# Vercel: set DATABASE_URL to a hosted PostgreSQL-compatible URL.
# DATABASE_URL=
# QHEALTH_DATABASE_URL=          # supported alias for DATABASE_URL

# Optional bearer protection. Keep empty only for a private local demo.
QHEALTH_API_TOKEN=
QHEALTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
QHEALTH_TRUSTED_HOSTS=localhost,127.0.0.1,backend,testserver,*.vercel.app

QHEALTH_UPLOAD_LIMIT_MB=20
QHEALTH_MAX_ROWS=100000
QHEALTH_MAX_COLUMNS=200
QHEALTH_QUANTUM_MAX_SAMPLES=256
QHEALTH_MAX_QUEUED_JOBS=3
QHEALTH_SERVERLESS_MAX_SAMPLES=512
QHEALTH_SERVERLESS_MAX_CV_FOLDS=3
QHEALTH_LOG_LEVEL=INFO

# Vercel object storage. Set QHEALTH_STORAGE_BACKEND=s3 and provide all
# required values. These names work with S3-compatible providers such as R2.
# QHEALTH_OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# QHEALTH_OBJECT_STORAGE_BUCKET=
# QHEALTH_OBJECT_STORAGE_ACCESS_KEY=
# QHEALTH_OBJECT_STORAGE_SECRET_KEY=
# QHEALTH_OBJECT_STORAGE_REGION=auto
# QHEALTH_OBJECT_STORAGE_PREFIX=qhealth
